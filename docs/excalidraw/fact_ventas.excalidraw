   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Venta neta oficial = monto_neto de las líneas\nno devueltas (las anuladas no llegan a Gold)\n→ KPI K1 venta neta · K2 ticket promedio",
   "originalText": "Venta neta oficial = monto_neto de las líneas\nno devueltas (las anuladas no llegan a Gold)\n→ KPI K1 venta neta · K2 ticket promedio",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 16,
   "autoResize": true
  },
  {
