  },
  {
   "id": "text-166343286e",
   "type": "text",
   "x": 78,
   "y": 1149,
   "width": 1168.2,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1954685056,
   "version": 1,
   "versionNonce": 1376773356,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "¿Qué significan S1, S2 y S3?   SCD = dimensión de cambio lento (cómo se guarda un dato que cambia)\nS1 · tipo 1: sobrescribe el valor y no guarda historia.   Ej.: corregir una marca mal escrita\nS2 · tipo 2: abre una versión nueva con su vigencia y guarda toda la historia.   Ej.: un cliente que se muda de región\nS3 · tipo 3: guarda el valor actual y el anterior.   Ej.: Smartwatches pasó de Accesorios a Tecnología",
   "originalText": "¿Qué significan S1, S2 y S3?   SCD = dimensión de cambio lento (cómo se guarda un dato que cambia)\nS1 · tipo 1: sobrescribe el valor y no guarda historia.   Ej.: corregir una marca mal escrita\nS2 · tipo 2: abre una versión nueva con su vigencia y guarda toda la historia.   Ej.: un cliente que se muda de región\nS3 · tipo 3: guarda el valor actual y el anterior.   Ej.: Smartwatches pasó de Accesorios a Tecnología",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 16,
   "autoResize": true
  },
  {
   "id": "text-70c5d87593",
   "type": "text",
   "x": 60,
   "y": 1303.0,
   "width": 1890.9,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 277479159,
   "version": 1,
   "versionNonce": 537003101,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PK clave primaria · FK clave foránea · M medida · DD dimensión degenerada · S1/S2/S3 atributo SCD tipo 1, 2 o 3 · gris: linaje y auditoría · ★ dimensión conformada que comparte con Inventario",
   "originalText": "PK clave primaria · FK clave foránea · M medida · DD dimensión degenerada · S1/S2/S3 atributo SCD tipo 1, 2 o 3 · gris: linaje y auditoría · ★ dimensión conformada que comparte con Inventario",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 16,
   "autoResize": true
  }
