   "updated": 1,
   "link": null,
   "locked": false,
   "text": "stock_cierre es semiaditiva: se suma entre productos\ny sucursales, nunca entre días (se usa el último día).\nes_quiebre = 1 cuando stock_cierre = 0  →  KPI K3\nstock / venta diaria de 28 días  →  KPI K4",
   "originalText": "stock_cierre es semiaditiva: se suma entre productos\ny sucursales, nunca entre días (se usa el último día).\nes_quiebre = 1 cuando stock_cierre = 0  →  KPI K3\nstock / venta diaria de 28 días  →  KPI K4",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 16,
   "autoResize": true
  },
