   "versionNonce": 1086374872,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Métricas oficiales de la capa semántica\ntasa_quiebre = 100 × SUM(es_quiebre) / COUNT(*)  → K3\ndias_cobertura = stock_cierre_mes × 28\n                 / unidades_vendidas_28d  → K4\nVistas: vw_inventario · vw_kpi_inventario_mensual\n· agg_inventario_mes",
   "originalText": "Métricas oficiales de la capa semántica\ntasa_quiebre = 100 × SUM(es_quiebre) / COUNT(*)  → K3\ndias_cobertura = stock_cierre_mes × 28\n                 / unidades_vendidas_28d  → K4\nVistas: vw_inventario · vw_kpi_inventario_mensual\n· agg_inventario_mes",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 15,
   "autoResize": true
  },
