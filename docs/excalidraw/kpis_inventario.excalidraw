   "versionNonce": 1008845287,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Medidas de fact_inventario (foto diaria del stock)\nstock_cierre · semiaditiva → K4 (nunca se suma entre días)\nunidades_vendidas · aditiva → K4 (ritmo de 28 días)\nunidades_recibidas · aditiva (reposición del día)\nstock_minimo · no aditiva (punto de reorden)\nes_quiebre · indicador (stock_cierre = 0) → K3",
   "originalText": "Medidas de fact_inventario (foto diaria del stock)\nstock_cierre · semiaditiva → K4 (nunca se suma entre días)\nunidades_vendidas · aditiva → K4 (ritmo de 28 días)\nunidades_recibidas · aditiva (reposición del día)\nstock_minimo · no aditiva (punto de reorden)\nes_quiebre · indicador (stock_cierre = 0) → K3",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 15,
   "autoResize": true
  },
